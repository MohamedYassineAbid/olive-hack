    {
      "parameters": {
        "jsCode": "const d = items[0].json;\nconst date     = d.date || new Date().toISOString().slice(0,10);\nconst national = d.national_reports || 0;\nconst preds    = d.predictions || [];\n\nconst top5 = preds.slice().sort((a,b)=>b.risk_score-a.risk_score).slice(0,5);\nconst highCount = preds.filter(p=>['High','Extreme'].includes(p.risk_level)).length;\n\nconst rows = top5.map(p=>`<tr><td style='padding:8px 12px'><strong>${p.governorate}</strong></td><td style='padding:8px 12px'><span style='background:${p.risk_color};color:#fff;padding:2px 10px;border-radius:12px;font-size:0.8rem'>${p.risk_level}</span></td><td style='padding:8px 12px'>${p.temp_max}°C</td><td style='padding:8px 12px'>${p.heat_stress}°C</td></tr>`).join('');\n\nconst html = `<!DOCTYPE html><html><head><meta charset='UTF-8'/></head><body style='font-family:Arial,sans-serif;background:#f4f6f9;padding:20px'><div style='max-width:620px;margin:auto'><h2 style='color:#1a1a2e'>📊 Daily Weather & Risk Report</h2><p style='color:#666;font-size:0.85rem;margin-bottom:16px'>${date} · hack-olive</p><table style='width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden;margin-bottom:16px'><tr style='background:#1a1a2e;color:#fff'><th style='padding:9px 12px;text-align:left'>Metric</th><th style='padding:9px 12px;text-align:left'>Value</th></tr><tr><td style='padding:8px 12px'>📋 National Outage Reports</td><td style='padding:8px 12px'><strong>${national.toLocaleString()}</strong></td></tr><tr style='background:#fafbfc'><td style='padding:8px 12px'>🏙️ Governorates Scored</td><td style='padding:8px 12px'><strong>${preds.length} / 24</strong></td></tr><tr><td style='padding:8px 12px'>🚨 High/Extreme Risk</td><td style='padding:8px 12px'><strong>${highCount}</strong></td></tr></table><h3 style='font-size:0.95rem;margin-bottom:8px'>Top 5 Risk Governorates</h3><table style='width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden'><tr style='background:#1a1a2e;color:#fff'><th style='padding:8px 12px;text-align:left'>Governorate</th><th style='padding:8px 12px;text-align:left'>Risk</th><th style='padding:8px 12px;text-align:left'>Temp</th><th style='padding:8px 12px;text-align:left'>Heat Index</th></tr>${rows}</table><p style='margin-top:14px;font-size:0.75rem;color:#aaa'>hack-olive · Tunisia Electricity Risk</p></div></body></html>`;\n\nreturn [{json:{subject:`📊 Daily Report — ${date} — ${highCount} high-risk gov(s)`,html}}];"
      },
