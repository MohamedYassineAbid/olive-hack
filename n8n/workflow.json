{
  "name": "Tunisia Electricity Risk — Daily Pipeline",
  "nodes": [
    {
      "id": "1",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Fetch Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 180],
      "parameters": {
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "latitude",      "value": "36.8065" },
            { "name": "longitude",     "value": "10.1815" },
            { "name": "daily",         "value": "temperature_2m_max,temperature_2m_min,temperature_2m_mean,relative_humidity_2m_max,wind_speed_10m_max,precipitation_sum" },
            { "name": "forecast_days", "value": "1" },
            { "name": "timezone",      "value": "Africa/Tunis" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Fetch Incidents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 420],
      "parameters": {
        "method": "GET",
        "url": "https://api.incident.tn/api/v1/history",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "type", "value": "electricity" },
            { "name": "days", "value": "7" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const weather   = $node[\"Fetch Weather\"].json;\nconst incidents = $node[\"Fetch Incidents\"].json;\n\nconst daily = weather.daily;\nconst today = daily.time[0];\n\nconst rows = (incidents && incidents.data && incidents.data.rows)\n  ? incidents.data.rows : [];\nconst todayRows = rows.filter(r => r.day === today);\nconst national  = todayRows.reduce((s, r) => s + (r.reports_down || 0), 0);\n\nconst days  = [...new Set(rows.map(r => r.day))].sort().slice(-3);\nconst roll3 = days.length\n  ? rows.filter(r => days.includes(r.day))\n      .reduce((s, r) => s + (r.reports_down || 0), 0) / (days.length * 24)\n  : 0;\n\nconst GOVS = [\n  'Tunis', 'Sfax', 'Sousse', 'Bizerte', 'Gabes',\n  'Nabeul', 'Ariana', 'Ben Arous', 'Monastir', 'Kairouan'\n];\n\nconst observations = GOVS.map(name => ({\n  governorate: name,\n  day:         today,\n  temp_max:    daily.temperature_2m_max[0],\n  temp_min:    daily.temperature_2m_min[0],\n  temp_mean:   daily.temperature_2m_mean[0],\n  rh_max:      daily.relative_humidity_2m_max[0],\n  wind_max:    daily.wind_speed_10m_max[0],\n  precip:      daily.precipitation_sum[0] || 0,\n  national_reports_down:  national,\n  national_reports_roll3: roll3,\n  reports_down_lag1:  0,\n  reports_down_lag2:  0,\n  reports_down_lag3:  0,\n  reports_down_roll3: 0,\n  reports_down_roll7: 0\n}));\n\nreturn [{ json: { observations, today, temp_max: daily.temperature_2m_max[0], national } }];"
      }
    },
    {
      "id": "5",
      "name": "Call Predict Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 180],
      "parameters": {
        "method": "POST",
        "url": "http://risk-api:8000/predict/batch",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ observations: $json.observations }) }}",
        "options": {}
      }
    },
    {
      "id": "6",
      "name": "Call Report National",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 420],
      "parameters": {
        "method": "POST",
        "url": "http://risk-api:8000/report/national",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ observations: $node['Build Payload'].json.observations }) }}",
        "options": {}
      }
    },
    {
      "id": "10",
      "name": "Build Daily Summary Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 620],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const today    = $node['Build Payload'].json.today;\nconst temp_max = $node['Build Payload'].json.temp_max;\nconst national = $node['Build Payload'].json.national;\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;padding:20px;background:#f4f6f9;border-radius:10px\">\n  <h2 style=\"color:#1a1a2e\">📊 Daily Weather & Outage Report — ${today}</h2>\n  <table style=\"width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden\">\n    <tr style=\"background:#1a1a2e;color:#fff\">\n      <th style=\"padding:10px 14px;text-align:left\">Metric</th>\n      <th style=\"padding:10px 14px;text-align:left\">Value</th>\n    </tr>\n    <tr><td style=\"padding:9px 14px\">🌡️ Max Temperature (Tunis)</td><td style=\"padding:9px 14px\"><strong>${temp_max}°C</strong></td></tr>\n    <tr style=\"background:#fafbfc\"><td style=\"padding:9px 14px\">📋 National Outage Reports</td><td style=\"padding:9px 14px\"><strong>${national.toLocaleString()}</strong></td></tr>\n    <tr><td style=\"padding:9px 14px\">📅 Date</td><td style=\"padding:9px 14px\">${today}</td></tr>\n  </table>\n  <p style=\"margin-top:16px;font-size:0.8rem;color:#aaa\">hack-olive · Tunisia Electricity Risk System · Automated daily digest</p>\n</div>`;\n\nreturn [{ json: { subject: `📊 Daily Report — ${today} — Temp: ${temp_max}°C`, html } }];"
      }
    },
    {
      "id": "7",
      "name": "Any High Risk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1260, 180],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.predictions.some(p => ['Extreme','High'].includes(p.risk_level)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1500, 80],
      "parameters": {
        "fromEmail": "alerts@hack-olive.tn",
        "toEmail":   "={{ $vars.ALERT_EMAIL || 'admin@hack-olive.tn' }}",
        "subject":   "={{ '⚡ HIGH/EXTREME electricity outage risk — ' + $node['Build Payload'].json.today }}",
        "emailType": "html",
        "message":   "={{ $node['Call Report National'].json.body || '<p>See attached risk report.</p>' }}"
      }
    },
    {
      "id": "9",
      "name": "No Alert Needed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1500, 300],
      "parameters": {}
    },
    {
      "id": "11",
      "name": "Send Daily Summary Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1260, 620],
      "parameters": {
        "fromEmail": "alerts@hack-olive.tn",
        "toEmail":   "={{ $vars.ALERT_EMAIL || 'admin@hack-olive.tn' }}",
        "subject":   "={{ $json.subject }}",
        "emailType": "html",
        "message":   "={{ $json.html }}"
      }
    }
  ],
  "connections": {
    "Daily Trigger": {
      "main": [[
        { "node": "Fetch Weather",   "type": "main", "index": 0 }
      ]]
    },
    "Fetch Weather": {
      "main": [[{ "node": "Fetch Incidents", "type": "main", "index": 0 }]]
    },
    "Fetch Incidents": {
      "main": [[{ "node": "Build Payload", "type": "main", "index": 0 }]]
    },
    "Build Payload": {
      "main": [[
        { "node": "Call Predict Batch",        "type": "main", "index": 0 },
        { "node": "Call Report National",      "type": "main", "index": 0 },
        { "node": "Build Daily Summary Email", "type": "main", "index": 0 }
      ]]
    },
    "Call Predict Batch": {
      "main": [[{ "node": "Any High Risk?", "type": "main", "index": 0 }]]
    },
    "Any High Risk?": {
      "main": [
        [{ "node": "Send Alert Email", "type": "main", "index": 0 }],
        [{ "node": "No Alert Needed",  "type": "main", "index": 0 }]
      ]
    },
    "Build Daily Summary Email": {
      "main": [[{ "node": "Send Daily Summary Email", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
