        "url": "http://risk-api:8000/report/national",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ observations: $node[\"Build Payload\"].json.observations }) }}\n",
        "options": {}
      },
      "id": "423354bc-c661-4565-8d75-4c86d24d71b4",
      "name": "Call Report National",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -496,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.predictions.some(p => ['Extreme','High'].includes(p.risk_level)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "72d90987-a4ce-4b2e-8b54-586554a2b1af",
      "name": "Any High Risk?",
